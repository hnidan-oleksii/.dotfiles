+            mvwprintw(input_win, 0, il_pos, "{%s}", arr[i]->name);
+            il_pos += strlen(arr[i]->name) + 2;
         }
+        if (hi < total - 1) mvwprintw(input_win, 0, il_pos++, ">");
         mvwprintw(input_win, 0, il_pos, "  ");
         il_pos += 2;
     }
