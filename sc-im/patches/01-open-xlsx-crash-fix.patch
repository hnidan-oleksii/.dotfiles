+++ b/src/cmds/cmds.c
@@ -1011,6 +1011,12 @@ void int_deleterow(struct sheet * sh, int row, int mult) {
             sh->row_format[r] = sh->row_format[r+1];
         }

+        // clear vacated last row; if it filled the last alloc'd row the shift
+        // stops early and aliases its ents up -> double free at teardown
