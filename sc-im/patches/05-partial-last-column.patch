diff --git a/src/cmds/cmds.c b/src/cmds/cmds.c
index 67133bb..667397b 100644
--- a/src/cmds/cmds.c
+++ b/src/cmds/cmds.c
@@ -2596,6 +2596,8 @@ int calc_mobile_rows(struct sheet * sh, int *last_p) {
     return mobile_rows;
 }

+int last_col_clipped = 0;
+
 /**
  * \brief Compute number of mobile (unfrozen) columns to fit on screen
  *
@@ -2614,6 +2616,7 @@ int calc_mobile_rows(struct sheet * sh, int *last_p) {
  */
 int calc_mobile_cols(struct sheet * sh, int *last_p) {
     int i, col_space, mobile_cols, last;
+    last_col_clipped = 0;

     /*
      * Compute the number of frozen columns and the space they need.
@@ -2652,8 +2655,17 @@ int calc_mobile_cols(struct sheet * sh, int *last_p) {
             continue;
         if (sh->col_frozen[i])
             continue;
-        if (sh->fwidth[i] > col_space)
+        if (sh->fwidth[i] > col_space) {
+            /* Count a too-wide column anyway so ncurses clips it at the right
+             * edge instead of leaving the space blank. Never curcol: that one
+             * must fit whole, so let the backward loop below reposition. */
+            if (col_space > 0 && i != sh->curcol) {
+                mobile_cols++;
+                last = i;
+                last_col_clipped = 1;
+            }
             break;
+        }
         col_space -= sh->fwidth[i];
         mobile_cols++;
         last = i;
diff --git a/src/cmds/cmds.h b/src/cmds/cmds.h
